# Ziggurat's own contract, enforced on Ziggurat.
#
# A ziggurat is a stepped structure: every level rests on the one below it and
# never the reverse. That is the whole idea the tool exists to check, so it
# would be a poor advertisement for it to be built any other way.
#
#   tier 0  findings   the shared vocabulary. Depends on nothing.
#   tier 1  analysers  each looks at ONE thing and returns findings.
#                      They do not know about each other.
#   tier 2  report     composes analysers. Knows them; they do not know it.
#   tier 3  bin        one entry point. Knows report.
#
# Run: lint-imports

[importlinter]
root_package = ziggurat
# required to name an external package (spindlebox) as forbidden
include_external_packages = True

[importlinter:contract:tiers]
name = Levels rest on the level below, never the reverse
type = layers
# Only what exists today. A contract written for the codebase you WANT fails
# on day one against the code it was pointed at, and a check that is red from
# the start teaches everyone to ignore it. Levels are added here as the modules
# that fill them are built.
layers =
    ziggurat.spindle_plugin
    ziggurat.cli
    ziggurat.sweep
    ziggurat.report
    ziggurat.structure | ziggurat.history
    ziggurat.findings

[importlinter:contract:platform-is-optional]
# The checks are standard-library only, so a checkout and a Python are the whole
# requirement and `bin/ziggurat.py` runs with nothing installed. Exactly one
# module may reach for the platform; this proves the claim rather than asserting
# it in a README.
name = Only the plugin module knows spindlebox exists
type = forbidden
source_modules =
    ziggurat.findings
    ziggurat.structure
    ziggurat.history
    ziggurat.report
    ziggurat.sweep
    ziggurat.shape
    ziggurat.cli
forbidden_modules =
    spindlebox

[importlinter:contract:analysers-independent]
name = Analysers do not know about each other
type = independence
modules =
    ziggurat.structure
    ziggurat.history
